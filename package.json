{
  "name": "poster",
  "version": "1.0.0",
  "type": "module",
  "description": "A4 landscape page poster project with TypeScript and CSS",
  "scripts": {
    "start": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "npm run test:ci && npm run test:e2e",
    "test:unit": "vitest",
    "test:ci": "vitest run",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:e2e": "playwright test",
    "report": "playwright show-report",
    "lint": "eslint",
    "lint:fix": "eslint --fix"
  },
  "keywords": [
    "a4",
    "poster"
  ],
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "@playwright/test": "1.65.0",
    "@types/node": "24.19.2",
    "@vitest/ui": "5.1.0",
    "eslint": "10.14.0",
    "http-server": "14.1.1",
    "jsdom": "31.0.0",
    "ts-node": "10.9.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "chart.js": "4.6.1",
    "i18next": "27.0.1",
    "i18next-browser-languagedetector": "8.3.0",
    "i18next-http-backend": "4.0.10"
  }
}
