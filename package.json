{
  "name": "poster",
  "version": "1.0.0",
  "type": "module",
  "description": "A4 landscape page poster project with TypeScript and CSS",
  "scripts": {
    "start": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "npm run test:ci && npm run test:e2e",
    "test:unit": "vitest",
    "test:ci": "vitest run",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:e2e": "playwright test",
    "report": "playwright show-report",
    "lint": "eslint",
    "lint:fix": "eslint --fix"
  },
  "keywords": [
    "a4",
    "poster"
  ],
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@vitest/ui": "5.0.5",
    "eslint": "10.13.0",
    "http-server": "14.1.1",
    "jsdom": "30.1.3",
    "ts-node": "10.9.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "chart.js": "4.6.1",
    "i18next": "26.5.8",
    "i18next-browser-languagedetector": "8.2.2",
    "i18next-http-backend": "4.0.5"
  }
}
